# Environment variables PrismGEO reads. Export them in your shell, process manager or Docker
# environment (Next.js itself only loads .env files from apps/web/). API keys, proxy and the
# rolling schedule are set in the dashboard (Settings) and stored in the local database.

# Network: the dashboard has no login, so it listens on localhost unless you change this (zsh sets HOST itself, hence the prefix).
PRISMGEO_HOST=127.0.0.1
PRISMGEO_PORT=3333

# Extra host names the dashboard answers to, comma-separated (localhost and PRISMGEO_URL's host
# are always allowed). Requests for any other Host are refused, which blocks DNS-rebinding attacks.
# PRISMGEO_ALLOWED_HOSTS=geo.example.com,mac-mini.local

# Database file (default: ./data/prismgeo.db at the repository root)
# PRISMGEO_DB_PATH=/absolute/path/to/prismgeo.db

# Public URL of the dashboard, used by the MCP connector's start_crawl tool
# PRISMGEO_URL=http://localhost:3333

# Browser binary (default: Google Chrome if installed, else Playwright's Chromium)
# CHROMIUM_PATH=/path/to/chrome

# Outbound proxy for browser engines; the Settings value takes precedence
# PRISMGEO_PROXY_URL=http://user:pass@proxy.example.com:8080

# API models (defaults shown)
# PRISMGEO_GEMINI_MODEL=gemini-flash-latest
# PRISMGEO_OPENAI_MODEL=gpt-5-mini
# PRISMGEO_PERPLEXITY_MODEL=sonar
