# Environment variables PrismGEO reads. `pnpm setup` copies this file to .env, which `pnpm start`
# and `pnpm dev` load (variables already set in your shell win). With Docker, set them in
# docker-compose.yml. API keys, the proxy, pacing and the rolling schedule are set in the
# dashboard (Settings) and stored in the local database, not here.

# Network: the dashboard has no login, so it listens on localhost unless you change this
# (zsh sets HOST itself, hence the prefix). Put authentication in front before exposing it.
PRISMGEO_HOST=127.0.0.1
PRISMGEO_PORT=3333

# Extra host names the dashboard answers to, comma-separated (localhost, 127.0.0.1, [::1] and
# PRISMGEO_URL's host are always allowed; 0.0.0.0 never is). Requests for any other Host are
# refused with 421, which blocks DNS-rebinding attacks.
# PRISMGEO_ALLOWED_HOSTS=geo.example.com,mac-mini.local

# Database file (default: ./data/prismgeo.db at the repository root). Logs, backups, crawl-debug
# snapshots and browser profiles are kept next to it.
# PRISMGEO_DB_PATH=/absolute/path/to/prismgeo.db

# Public URL of the dashboard. The stdio MCP connector's start_crawl tool posts to it
# (default: http://127.0.0.1:$PRISMGEO_PORT); its host is also allowed by the Host check.
# PRISMGEO_URL=http://localhost:3333

# Server and crawler console output is also written to data/logs/prismgeo.log (rotated at 5 MB,
# 5 old files kept). Set to off to disable the log file.
# PRISMGEO_LOG_FILE=off

# Browser binary for the crawler (default: Playwright's Chromium from `pnpm browsers`; on macOS an
# installed Google Chrome may be preferred)
# CHROMIUM_PATH=/path/to/chrome

# Outbound proxy for browser engines; the Settings value takes precedence
# PRISMGEO_PROXY_URL=http://user:pass@proxy.example.com:8080

# API models (defaults shown)
# PRISMGEO_GEMINI_MODEL=gemini-flash-latest
# PRISMGEO_OPENAI_MODEL=gpt-5-mini
# PRISMGEO_PERPLEXITY_MODEL=sonar

# How long an audit holds an engine for you to complete a "verify you are human" check or a
# sign-in (see the bell), in minutes; 0 never waits. Nothing waits on a server without a screen.
# PRISMGEO_PERSON_WAIT_MIN=15

# Country this computer searches from, when the automatic check cannot reach the network (two-letter code)
# PRISMGEO_CONNECTION_COUNTRY=us

# Parallel requests per engine on a paid route (1-10; default per provider)
# PRISMGEO_API_CONCURRENCY=2

# DataForSEO endpoint and the Perplexity model it asks (defaults shown)
# PRISMGEO_DATAFORSEO_URL=https://api.dataforseo.com
# PRISMGEO_DATAFORSEO_PERPLEXITY_MODEL=sonar

# Set by the Docker image: no sign-in or check windows can be shown
# PRISMGEO_IN_DOCKER=1
